{
    "env": {
        "dependencies": [
            "@vanilla-datapack",
            "@vanilla-resourcepack",
            "@vanilla-mcdoc"
        ],
        "exclude": [
            "**/node_modules/**",
            "**/__pycache__/**",
            "**/overlay_*/**",
            "resource_pack/**",
            "**/resource_pack/**",
            "nullscape_compat/**",
            "**/nullscape_compat/**"
        ]
    },
    "lint": {
        "undeclaredSymbol": [
            {
                "if": {
                    "namespace": "c"
                },
                "then": {
                    "declare": "public"
                }
            }
        ]
    }
}